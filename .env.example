# --- Postgres (used by docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plcm
POSTGRES_PORT=5432

# Overridden inside compose to host "db". Keep for local non-Docker runs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plcm

# JWT / auth — change AUTH_SECRET_KEY on every real deployment
AUTH_SECRET_KEY=change-me-to-a-long-random-string
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-run default Admin user (username: admin). Set to false to skip creation.
CREATE_DEFAULT_ADMIN=true

# Bootstrap value for Admin session-takeover super password (hashed into security settings
# on first load). Change in Settings → Security after deploy; override here for first run.
ADMIN_SESSION_SUPER_PASSWORD=super@admin82768243

# Spec 00 demo matrix users (demo-pd / demo-hm / demo-im / demo-dev). Prefer false on client PCs.
CREATE_WORKFLOW_DEMO_USERS=false

# CORS (comma-separated origins). Leave empty to use built-in defaults.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Private LAN + known public hosts (tighten for internet-facing deploys)
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+|193\.193\.193\.\d+)(:\d+)?

# File uploads (container path is /app/uploads via compose)
PLCM_UPLOAD_DIR=uploads

# Uvicorn (used when running `python -m app.main` outside Docker)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false

# Frontend port mapping (compose)
FRONTEND_PORT=3000

# Browser API URL baked into the frontend image at build time.
# For LAN access leave as localhost — the app rewrites hostname to the page origin.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Spec 06 — reservation expiry
RESERVATION_IDLE_DAYS=30
RESERVATION_GRACE_DAYS=7
RESERVATION_EXPIRY_JOB_ENABLED=true
RESERVATION_EXPIRY_JOB_INTERVAL_SECONDS=3600

        <mxCell id="sv6" value="BER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feb2b2;strokeColor=#c53030;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="250" width="80" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sv7" value="Quarantined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="250" width="110" height="36" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="Minimum Records &amp; Forms" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="recBox" value="• RMA / Field Fault Report — customer/site, asset ID, P/N/S/N, symptom, conditions, logs, warranty&#xa;• Receiving &amp; Incoming Inspection — WO, package/accessories, photos, damage, identity, safety/ESD, accept/hold&#xa;• Diagnostic Worksheet — setup, instruments/cal IDs, FW/config, steps, readings, reproduced?, classification&#xa;• Repair / Replacement Record — root cause, approval, actions, old/new P/N/S/N, SW/config changes, tech/date&#xa;• Functional / Performance Test Report — procedure rev, limits+source, actual values, pass/fail, retests, sign-off&#xa;• Nonconformance / Corrective Action — failure, containment, root cause, CAPA, trend, closure authority&#xa;• Release &amp; Dispatch Record — QA release, final status, certificate, packing, ship-to, tracking, WO closure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="780" height="180" as="geometry" />
        </mxCell>

        <mxCell id="equip" value="Typical test equipment (calibrated)&#xa;&#xa;DMM · Bench PSU · Oscilloscope&#xa;Spectrum / Network Analyzer&#xa;Signal generator · Power meter&#xa;Attenuators / couplers / loads&#xa;Product-specific fixtures &amp; SW&#xa;ESD workstation · mechanical tools&#xa;&#xa;Record equipment ID + cal due&#xa;date on every test record." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="860" y="360" width="280" height="240" as="geometry" />
        </mxCell>

        <mxCell id="t3" value="Life-Cycle Support &amp; Fleet Controls" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lcs1" value="Installed-base register&#xa;System ↔ config baseline&#xa;LRU ↔ P/N·S/N·rev·FW·site&#xa;+ full repair history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lcs2" value="Fleet KPIs&#xa;Failure rate · MTTR · TAT&#xa;NFF rate · repeat failure&#xa;Repair yield · obsolescence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="270" y="620" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lcs3" value="Spares policy&#xa;Repairables · consumables&#xa;Long-lead / obsolete&#xa;Min/max from history+lead time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="620" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lcs4" value="Technology migration&#xa;Separate legacy vs new config&#xa;Pilot before fleet rollout&#xa;End-of-support plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="750" y="620" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t4" value="Suggested Service-Level Metrics (set contractually)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sla" value="Receipt acknowledgement · Triage time · Repair turnaround (excl. customer/OEM holds) · First-pass yield · Repeat failure window · NFF rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="1100" height="44" as="geometry" />
        </mxCell>

        <mxCell id="t5" value="Roles (RACI snapshot)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="roleBox" value="Receiving / Stores — shipment check, receipt ID, photos, quarantine&#xa;Repair Coordinator — validate RMA, create WO, prioritize, customer comms&#xa;Technician / Diagnostician — safe inspection, reproduce fault, tests, evidence, propose repair&#xa;Repair Authority — approve method, deviations, substitutions, OEM escalation&#xa;QA / Independent Tester — compliance, nonconformities, authorize release&#xa;Configuration / Logistics — BOM, FW baseline, S/N history, spares, dispatch records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1100" height="140" as="geometry" />
        </mxCell>

        <mxCell id="qgRules" value="Quality gate rules (never bypass)&#xa;1. Accept only with valid RMA / authorization&#xa;2. Verify correct diagnosis before repair&#xa;3. Use approved parts / LRUs only&#xa;4. Follow ESD and safety procedures&#xa;5. Pass all mandatory functional / performance tests&#xa;6. Maintain full traceability and records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c53030;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1180" y="360" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="impl" value="Implementation checklist (pre-go-live)&#xa;&#xa;Approve owners, safety rules, OEM/contract docs · Controlled forms · LRU-specific test procedures &amp; limits · Train &amp; authorize staff · ESD quarantine + diagnostic + test + finished-goods areas · Pilot on representative returns · Audit first cases for completeness &amp; independent QA release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1180" y="570" width="320" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

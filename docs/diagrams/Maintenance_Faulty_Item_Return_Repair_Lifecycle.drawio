        <mxCell id="dG3" value="G3 Repair&#xa;authorized?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="180" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pathR" value="REPAIR path&#xa;Status: AUTH → REPR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="140" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pathX" value="REPLACE / OEM / BER&#xa;Awaiting parts or approval&#xa;Status: PART / BER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontStyle=1;fontSize=11;" vertex="1" parent="1">

        <mxCell id="r4a" value="Reliability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r4b" value="Root cause correctable;&#xa;recurrence risk acceptable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="260" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r4c" value="Repeated failure; latent damage;&#xa;reliability cannot be demonstrated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="400" height="50" as="geometry" />

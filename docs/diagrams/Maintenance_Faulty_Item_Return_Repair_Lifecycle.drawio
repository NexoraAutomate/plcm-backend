        <mxCell id="t2" value="Section D — Diagnosis &amp; Root-Cause Analysis (G2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#975a16;" vertex="1" parent="1">

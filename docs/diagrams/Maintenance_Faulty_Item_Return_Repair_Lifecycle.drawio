        <mxCell id="t1" value="Section A — Field Return Authorization &amp; Work Order" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#2b6cb0;" vertex="1" parent="1">

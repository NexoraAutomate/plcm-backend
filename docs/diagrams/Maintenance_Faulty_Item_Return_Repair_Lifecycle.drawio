        <mxCell id="b6" value="Incoming Inspection Checklist&#xa;&#xa;• Physical damage / impact&#xa;• Tampering / seals&#xa;• Corrosion / moisture / liquid ingress&#xa;• Missing parts &amp; accessories&#xa;• Connectors, cables, interfaces&#xa;• Burnt / overheated evidence&#xa;• Unsafe power / energy hazards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="280" height="180" as="geometry" />
        </mxCell>


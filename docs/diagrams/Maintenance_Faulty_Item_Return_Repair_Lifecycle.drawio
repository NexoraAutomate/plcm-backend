        <mxCell id="b7" value="Do NOT power up if:&#xa;short · liquid ingress ·&#xa;damaged power/RF path ·&#xa;exposed conductors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">

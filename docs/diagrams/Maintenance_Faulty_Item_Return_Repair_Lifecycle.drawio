        <mxCell id="d2" value="Non-invasive first&#xa;Logs · BIT · LEDs · alarms&#xa;FW / config review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="350" width="180" height="60" as="geometry" />

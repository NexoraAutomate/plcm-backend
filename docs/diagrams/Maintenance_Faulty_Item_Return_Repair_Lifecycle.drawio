        <mxCell id="ed2" style="endArrow=block;endFill=1;strokeColor=#975a16;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed3" style="endArrow=block;endFill=1;strokeColor=#975a16;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="d5" value="Document diagnosis&#xa;&#xa;• Confirmed vs suspected cause&#xa;• Measurements &amp; failed test step&#xa;• Probable root cause&#xa;• Contributing factors&#xa;• Confidence level&#xa;• Recommended action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="dEsc" value="Escalate to OEM when&#xa;&#xa;• Proprietary calibration&#xa;• Sealed module / alignment&#xa;• High-energy / hazardous work&#xa;• Firmware signing required&#xa;• Schematics unavailable&#xa;• Safety-critical disposition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">

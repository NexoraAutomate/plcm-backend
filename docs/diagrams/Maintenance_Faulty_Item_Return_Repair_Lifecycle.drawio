        <mxCell id="d3" value="Isolate to smallest&#xa;replaceable assembly&#xa;(avoid unnecessary teardown)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=10;" vertex="1" parent="1">

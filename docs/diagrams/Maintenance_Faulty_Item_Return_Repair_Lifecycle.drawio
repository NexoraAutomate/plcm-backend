  <diagram id="page-repair" name="04 Repair vs Replace">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="Section E — Repair-versus-Replace Decision Matrix (G3)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#6b46c1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="hdr" value="Decision factor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#553c9a;strokeColor=#553c9a;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdrR" value="Favour REPAIR when…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#276749;strokeColor=#276749;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="70" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdrX" value="Favour REPLACE / ESCALATE when…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c53030;strokeColor=#c53030;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="r1a" value="Technical&#xa;feasibility" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r1b" value="Approved method exists; post-repair&#xa;performance can be verified" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r1c" value="No approved method; extensive damage;&#xa;sealed / untestable repair" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r2a" value="Availability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r2b" value="Parts, tooling, software and trained&#xa;staff are available" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="160" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r2c" value="Parts obsolete; counterfeit risk;&#xa;lead time unacceptable; OEM-only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="r3a" value="Economics /&#xa;warranty" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r3b" value="Repair cost &amp; turnaround meet&#xa;contract and warranty conditions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="210" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r3c" value="Exceeds threshold; replacement&#xa;faster/cheaper over life cycle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="210" width="400" height="50" as="geometry" />

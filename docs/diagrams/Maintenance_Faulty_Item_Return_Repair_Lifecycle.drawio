        <mxCell id="dG2" value="G2&#xa;Diagnosis&#xa;approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#c05621;fontStyle=1;fontSize=11;" vertex="1" parent="1">

        <mxCell id="r5a" value="Configuration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r5b" value="Repair preserves approved design&#xa;and full traceability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="310" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r5c" value="Substitution changes form/fit/function,&#xa;firmware, performance or certification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="310" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="noteAuth" value="Threshold must be customer/programme-approved. Do not substitute different P/N or firmware without engineering + configuration-control approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c53030;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="920" height="40" as="geometry" />

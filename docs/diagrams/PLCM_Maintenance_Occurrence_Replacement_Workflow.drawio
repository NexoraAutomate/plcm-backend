<mxfile host="app.diagrams.net" agent="PLCM-Maintenance-Workflow" version="22.1.0" type="device" pages="6">
  <diagram id="page-overview" name="01 Overview &amp; Principles">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="PLCM Maintenance Augmentation — Occurrence Report + Parallel Replacement / Inspection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1640" height="36" as="geometry" />
        </mxCell>
        <mxCell id="t1b" value="Augments existing maintenance case flow. Does not replace soft-fix, tree investigation, IM rework queue, warranty claim, or delivery-close paths already in PLCM." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#4a5568;" vertex="1" parent="1">
          <mxGeometry x="80" y="56" width="1640" height="24" as="geometry" />
        </mxCell>

        <mxCell id="princ" value="Design principles&#xa;• Augment only — keep CaseStatus (open → under_inspection → under_repair → resolved → closed)&#xa;• Dual-track after fault confirmation: Track A Replacement (do not wait for faulty return) + Track B Faulty return/inspection (starts on reception)&#xa;• New actors ME / FSE / IE sit beside existing PD / IM; existing permissions remain&#xa;• Red “Replacement case open” on Project / Order / Flight / SDLS until AIT pass + case closed&#xa;• Badges: Replaced (new S/N) · Discarded (trash, never reusable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#2c5282;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="820" height="160" as="geometry" />
        </mxCell>

        <mxCell id="roles" value="Role map (new + existing)&#xa;&#xa;FSE — Field Service Engineer: onsite presence, Occurrence Report, site replace/integrate with ME&#xa;ME — Maintenance Engineer (NEW): owns replacement request → IM issue → site AIT → PD notify&#xa;PD — Project Director: approve replacement, assign ME/IE, Approve/Reject AIT, verify repair tests&#xa;IM — Inventory Manager: issue replacement S/N, receive faulty, issue to IE, discard/trash, restock repaired&#xa;IE — Inspection Engineer (NEW): inspect faulty, warranty vs discard vs repair, update investigation status&#xa;&#xa;Existing roles HM / Admin / Dev unchanged. Legacy role “Maintenance” remains notify target until ME is seeded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;align=left;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="820" height="160" as="geometry" />
        </mxCell>

        <!-- Chevron -->
        <mxCell id="c0" value="1 Case open&#xa;(existing)" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="150" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="2 Occurrence&#xa;Report" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="300" width="150" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="3 Fault&#xa;confirm" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="140" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="4A Immediate&#xa;replacement" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="300" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="4B Faulty&#xa;return (parallel)" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="300" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="5 AIT / PD&#xa;gate" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="300" width="140" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="6 Inspect /&#xa;Repair / Discard" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#c05621;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="300" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="7 Close&#xa;case" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="300" width="140" height="56" as="geometry" />
        </mxCell>

        <!-- Master flow boxes -->
        <mxCell id="mTitle" value="Master flow (logical) — existing steps grey; new / modified blue-purple" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="700" height="28" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Case open&#xa;(existing)&#xa;&#xa;Lookup S/N · project gate&#xa;production-support check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Occurrence Report&#xa;(rename onsite)&#xa;&#xa;Occurrence date ≠ recorded&#xa;Attachments (named)&#xa;FSE officers + roles&#xa;Outcome + Fault type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="290" y="430" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Outcome&#xa;branch?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="430" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Soft fix / NFF&#xa;&#xa;Soft fix → resolve soft_fixed&#xa;NFF → confirm close/resolve&#xa;Inconclusive → keep open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="730" y="430" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Fault identified&#xa;&#xa;Confirm via email / letter / call&#xa;Start Track A immediately&#xa;Tree investigation continues&#xa;(existing) in parallel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="980" y="430" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="Dual track&#xa;&#xa;A: ME replacement + AIT&#xa;B: Faulty → IM → IE&#xa;Close when both complete&#xa;(AIT pass + inspect closed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1250" y="430" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="s2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e34" value="Soft / NFF /&#xa;Inconclusive" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;fontSize=10;fontStyle=1;" edge="1" parent="1" source="d3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e35" value="Fault&#xa;identified" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;fontSize=10;fontStyle=1;" edge="1" parent="1" source="d3" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend&#xa;Grey = existing preserved&#xa;Blue = Occurrence Report UI&#xa;Purple = Replacement track (ME)&#xa;Green = Inspection / close&#xa;Yellow = decision&#xa;Red = AIT / dual-track gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#dd6b20;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="map" value="How this maps onto existing PLCM&#xa;&#xa;• Occurrence Report replaces UI label “Onsite visit outcome” / button “Record onsite outcome” — API can keep onsite_* fields + add occurrence_date, attachments[], officers[]&#xa;• Fault types already exist as FaultType enum (Electrical, Mechanical, Environmental, Hardware, Manufacturing Defect, Physical Damage, Software, Unclassified, Wear, Other) — surface on Occurrence Report&#xa;• Track A uses / extends resolution_type=replaced + stock issue; adds ME request + PD approve + AIT loop before case close&#xa;• Track B uses / extends returned_unit rework + IM inspect queue; adds PD→IE assignment and “Inspection under process” / “Repair under progress” sub-statuses&#xa;• Soft fix path unchanged (resolve_soft_fixed). NFF adds explicit confirm-to-close dialog (new UX on existing resolution_type=no_fault_found)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#718096;align=left;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="580" width="1160" height="150" as="geometry" />
        </mxCell>

        <mxCell id="pages" value="Pages: 01 Overview · 02 Occurrence Report · 03 Dual-track split · 04 Replacement / AIT (ME) · 05 Faulty inspection (IE) · 06 Statuses, badges, gaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;strokeColor=#1a365d;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="1470" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-occurrence" name="02 Occurrence Report">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ot" value="Occurrence Report (formerly Onsite visit outcome)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="otb" value="Recorded after case open. Captures field event facts separately from system audit timestamps." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#4a5568;" vertex="1" parent="1">
          <mxGeometry x="200" y="56" width="1400" height="24" as="geometry" />
        </mxCell>

        <!-- Form panel -->
        <mxCell id="form" value="Occurrence Report form fields" style="swimlane;fontStyle=1;startSize=28;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="520" height="520" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="1. Occurrence Date (user) — when the field event happened&#xa;2. Recorded Date/Time (system) — onsite_recorded_at (immutable)&#xa;3. Recorded By (system) — onsite_recorded_by_id&#xa;4. Outcome (required) — see dropdown&#xa;5. Fault Type (required if fault / optional otherwise) — see list&#xa;6. Soft-fix method — only if Soft fix (existing)&#xa;7. Notes / narrative&#xa;8. Attachments[] — each: file + user-defined name&#xa;   (tests, reports, emails, letters, photos)&#xa;9. Field officers[] — dialog: name/user + onsite role&#xa;10. Confirmation channel (if fault) — email / letter / call&#xa;    + reference id / attachment link" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="form">
          <mxGeometry x="10" y="40" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Button: Record Occurrence Report&#xa;(was: Record onsite outcome)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;strokeColor=#2b6cb0;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="form">
          <mxGeometry x="80" y="340" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Preserve existing API fields; add occurrence_date,&#xa;attachments[{name,file}], officers[{user_id,role_onsite}],&#xa;fault_type on report, confirmation_channel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="form">
          <mxGeometry x="20" y="400" width="480" height="90" as="geometry" />
        </mxCell>

        <!-- Outcome dropdown -->
        <mxCell id="outBox" value="Outcome dropdown (existing + NFF)" style="swimlane;fontStyle=1;startSize=28;fillColor=#fefcbf;strokeColor=#975a16;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="100" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="• Soft fix (existing soft_fix)&#xa;• PN / hardware fault (existing fault_identified)&#xa;• Inconclusive (existing)&#xa;• No Fault Found (NEW outcome value&#xa;  OR map to resolution NFF with prompt)&#xa;&#xa;After save:&#xa;Soft fix → auto resolve soft_fixed (keep)&#xa;NFF → modal: Close / resolve case as NFF?&#xa;  Yes → resolve + close path&#xa;  No → leave case open with NFF note&#xa;Inconclusive → case stays open&#xa;Fault identified → enable Track A CTA" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="outBox">
          <mxGeometry x="10" y="36" width="340" height="250" as="geometry" />
        </mxCell>

        <!-- Fault type -->
        <mxCell id="ftBox" value="Fault Type (from product list / FaultType enum)" style="swimlane;fontStyle=1;startSize=28;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ft1" value="1. Electrical&#xa;2. Mechanical&#xa;3. Environmental&#xa;4. Hardware&#xa;5. Manufacturing Defect&#xa;6. Physical Damage&#xa;7. Software&#xa;8. Unclassified (default)&#xa;9. Wear&#xa;10. Other&#xa;&#xa;Shown alongside Outcome when&#xa;fault_identified (and optionally NFF&#xa;classification). Matches attached UI list." style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="ftBox">
          <mxGeometry x="10" y="36" width="340" height="250" as="geometry" />
        </mxCell>

        <!-- FSE dialog -->
        <mxCell id="fse" value="Field officers dialog (FSE+)" style="swimlane;fontStyle=1;startSize=28;fillColor=#c6f6d5;strokeColor=#276749;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="430" width="360" height="280" as="geometry" />
        </mxCell>
        <mxCell id="fse1" value="Open dialog → Add officer rows:&#xa;• User (directory) or free-text guest&#xa;• Designated onsite role&#xa;  e.g. Lead FSE, FSE, Customer Rep,&#xa;  Observer, ME (if already on site)&#xa;• Optional contact / phone&#xa;&#xa;At least one FSE recommended when&#xa;outcome = fault_identified.&#xa;Stored on case for audit &amp; later&#xa;site-replace coordination with ME." style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="fse">
          <mxGeometry x="10" y="36" width="340" height="230" as="geometry" />
        </mxCell>

        <!-- Attachments -->
        <mxCell id="att" value="Named attachments" style="swimlane;fontStyle=1;startSize=28;fillColor=#feebc8;strokeColor=#c05621;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="430" width="360" height="280" as="geometry" />
        </mxCell>
        <mxCell id="att1" value="Each upload requires a Display Name&#xa;defined by the user, e.g.:&#xa;• “Customer fault email 03-Nov”&#xa;• “AIT pretest PDF”&#xa;• “Supplier letter”&#xa;&#xa;Types: test reports, emails, letters,&#xa;photos, logs. Reusable later as&#xa;evidence for warranty / IE / PD AIT gate.&#xa;&#xa;Missing (gap fill): attachment category&#xa;tag + virus-scan / size limits (ops)." style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="att">
          <mxGeometry x="10" y="36" width="340" height="230" as="geometry" />
        </mxCell>

        <!-- Flow after record -->
        <mxCell id="af" value="After Record Occurrence Report" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="dOut" value="Outcome?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="aSoft" value="Soft fix&#xa;→ resolve soft_fixed&#xa;(existing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="700" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aNff" value="No Fault Found&#xa;→ Confirm close/resolve?&#xa;Yes: NFF + closed&#xa;No: note only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="700" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="aInc" value="Inconclusive&#xa;→ stay Open&#xa;further visit / data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="700" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aFlt" value="Fault identified&#xa;→ CTA: Request immediate&#xa;replacement (Track A)&#xa;+ continue investigation tree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="700" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="eo1" value="Soft" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;fontSize=10;" edge="1" parent="1" source="dOut" target="aSoft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eo2" value="NFF" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c53030;fontSize=10;" edge="1" parent="1" source="dOut" target="aNff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eo3" value="Inc." style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4a5568;fontSize=10;" edge="1" parent="1" source="dOut" target="aInc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eo4" value="Fault" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;fontSize=10;" edge="1" parent="1" source="dOut" target="aFlt"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-dual" name="03 Dual-Track Split">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dt" value="After fault confirmation — Dual track (do not wait for faulty item)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1560" height="36" as="geometry" />
        </mxCell>
        <mxCell id="dtb" value="Replacement ships immediately from SUPARCO stock (same specs). Faulty item return is parallel and may start later on client reception." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#4a5568;" vertex="1" parent="1">
          <mxGeometry x="120" y="56" width="1560" height="24" as="geometry" />
        </mxCell>

        <mxCell id="start" value="Fault confirmed&#xa;(Occurrence Report + email/letter/call evidence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- Track A -->
        <mxCell id="ta" value="TRACK A — Immediate Replacement (ME-led)" style="swimlane;fontStyle=1;startSize=32;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="820" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ta1" value="ME creates Replacement Request&#xa;linked to maintenance case + entity S/N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#6b46c1;fontSize=11;" vertex="1" parent="ta">
          <mxGeometry x="40" y="50" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ta2" value="PD reviews &amp; Approves&#xa;Assigns / confirms ME" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#6b46c1;fontSize=11;" vertex="1" parent="ta">
          <mxGeometry x="420" y="50" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ta3" value="ME → Request IM to ISSUE&#xa;same-spec fresh inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#6b46c1;fontSize=11;" vertex="1" parent="ta">
          <mxGeometry x="40" y="140" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ta4" value="IM ships replacement S/N&#xa;→ RED notification on Project / Order / Flight / SDLS&#xa;→ entity shows new S/N + badge Replaced&#xa;→ faulty auto-queued for IM return on arrival" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="ta">
          <mxGeometry x="420" y="130" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ta5" value="ME + FSE visit customer site&#xa;Replace / repair / integrate equipment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#6b46c1;fontSize=11;" vertex="1" parent="ta">
          <mxGeometry x="40" y="250" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ta6" value="ME notifies PD:&#xa;Shipment / AIT in Progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#6b46c1;fontSize=11;" vertex="1" parent="ta">
          <mxGeometry x="420" y="250" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ta7" value="PD waits for Integration / Testing results&#xa;Approve OR Reject replacement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=11;" vertex="1" parent="ta">
          <mxGeometry x="40" y="340" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ta8" value="Reject → notify IM + issue NEW replacement&#xa;to SAME ME → loop until AIT pass&#xa;Approve → patch delivered / Track A complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#6b46c1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="ta">
          <mxGeometry x="420" y="340" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ta9" value="See page 04 for full Replacement / AIT detail + stock-shortage &amp; abort gaps" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#553c9a;fontStyle=2;" vertex="1" parent="ta">
          <mxGeometry x="40" y="450" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="eta12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;" edge="1" parent="ta" source="ta1" target="ta2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eta23" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;" edge="1" parent="ta" source="ta2" target="ta3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eta34" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;" edge="1" parent="ta" source="ta3" target="ta4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eta45" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;" edge="1" parent="ta" source="ta4" target="ta5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eta56" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;" edge="1" parent="ta" source="ta5" target="ta6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eta67" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;" edge="1" parent="ta" source="ta6" target="ta7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eta78" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;" edge="1" parent="ta" source="ta7" target="ta8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Track B -->
        <mxCell id="tb" value="TRACK B — Faulty Return &amp; Inspection (parallel)" style="swimlane;fontStyle=1;startSize=32;fillColor=#c6f6d5;strokeColor=#276749;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="220" width="820" height="520" as="geometry" />
        </mxCell>
        <mxCell id="tb1" value="Faulty item in transit from customer&#xa;(may start AFTER Track A already shipping)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#276749;fontSize=11;" vertex="1" parent="tb">
          <mxGeometry x="40" y="50" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tb2" value="IM records Reception Date&#xa;Notify PD: Faulty item received" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#276749;fontSize=11;" vertex="1" parent="tb">
          <mxGeometry x="420" y="50" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tb3" value="PD assigns Inspection Engineer (IE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#276749;fontSize=11;" vertex="1" parent="tb">
          <mxGeometry x="40" y="140" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tb4" value="IE requests IM handover → IM issues faulty to IE&#xa;Status → Inspection under process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#276749;fontSize=11;" vertex="1" parent="tb">
          <mxGeometry x="420" y="140" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tb5" value="IE disposition:&#xa;Irreparable → warranty? claim : discard&#xa;Repairable → Repair under progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="tb">
          <mxGeometry x="40" y="230" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tb6" value="Repair path: IE repairs → PD verifies tests&#xa;→ mark repaired + reports → IM restock&#xa;Discard path: IM trash → badge Discarded&#xa;Warranty path: ship to supplier (existing claim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#276749;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="tb">
          <mxGeometry x="420" y="230" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tb7" value="Track B complete when item restocked, discarded,&#xa;or warranty claim closed. See page 05." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#276749;fontStyle=2;" vertex="1" parent="tb">
          <mxGeometry x="40" y="360" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tb8" value="Augments existing create_returned_unit_rework on replace — reception can lag shipment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="tb">
          <mxGeometry x="40" y="420" width="740" height="50" as="geometry" />
        </mxCell>

        <mxCell id="etb12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;" edge="1" parent="tb" source="tb1" target="tb2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="etb23" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;" edge="1" parent="tb" source="tb2" target="tb3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="etb34" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;" edge="1" parent="tb" source="tb3" target="tb4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="etb45" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;" edge="1" parent="tb" source="tb4" target="tb5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="etb56" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;" edge="1" parent="tb" source="tb5" target="tb6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="esA" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#6b46c1;" edge="1" parent="1" source="start" target="ta">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="200" />
              <mxPoint x="450" y="200" />
            </Array>
          </mxGeometry>

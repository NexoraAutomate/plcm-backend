        <mxCell id="esB" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#276749;" edge="1" parent="1" source="start" target="tb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="200" />
              <mxPoint x="1310" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="join" value="CASE CLOSE GATE&#xa;Track A AIT Approved (patch delivered) AND Track B terminal (restocked / discarded / warranty closed)&#xa;OR Soft/NFF early exit without dual track. Existing delivery-confirm close still allowed when applicable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;strokeColor=#1a365d;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="780" width="1280" height="70" as="geometry" />

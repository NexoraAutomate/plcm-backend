  </diagram>

  <diagram id="page-replace" name="04 Replacement &amp; AIT (ME)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="rt" value="Track A detail — Maintenance Engineer replacement &amp; AIT loop" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1500" height="36" as="geometry" />
        </mxCell>

        <!-- Swimlanes by role -->
        <mxCell id="laneME" value="ME" style="swimlane;horizontal=0;startSize=40;fillColor=#faf5ff;strokeColor=#6b46c1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lanePD" value="PD" style="swimlane;horizontal=0;startSize=40;fillColor=#fffaf0;strokeColor=#c05621;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="1720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="laneIM" value="IM" style="swimlane;horizontal=0;startSize=40;fillColor=#ebf8ff;strokeColor=#2b6cb0;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="laneFSE" value="FSE" style="swimlane;horizontal=0;startSize=40;fillColor=#f0fff4;strokeColor=#276749;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1720" height="120" as="geometry" />
        </mxCell>

        <!-- ME steps -->
        <mxCell id="me1" value="1. Create&#xa;Replacement&#xa;Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;fontStyle=1;" vertex="1" parent="laneME">
          <mxGeometry x="60" y="40" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="me2" value="4. Request IM&#xa;ISSUE stock&#xa;(same specs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;fontStyle=1;" vertex="1" parent="laneME">
          <mxGeometry x="520" y="40" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="me3" value="6. Take custody&#xa;of replacement&#xa;from IM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;fontStyle=1;" vertex="1" parent="laneME">
          <mxGeometry x="820" y="40" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="me4" value="7. Notify PD&#xa;Shipment/AIT&#xa;in Progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;fontStyle=1;" vertex="1" parent="laneME">
          <mxGeometry x="1000" y="40" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="me5" value="9. Site replace&#xa;+ integrate&#xa;w/ FSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;fontStyle=1;" vertex="1" parent="laneME">
          <mxGeometry x="1180" y="40" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="me6" value="10. Upload AIT&#xa;test results&#xa;/ attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;fontStyle=1;" vertex="1" parent="laneME">
          <mxGeometry x="1360" y="40" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="me7" value="12b. If Rejected&#xa;receive NEW unit&#xa;repeat 6–10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;fontStyle=1;" vertex="1" parent="laneME">
          <mxGeometry x="1540" y="40" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- PD steps -->
        <mxCell id="pd1" value="2. Review request&#xa;Approve / Reject&#xa;Assign ME" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#c05621;fontSize=11;fontStyle=1;" vertex="1" parent="lanePD">
          <mxGeometry x="220" y="40" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pd2" value="8. Wait for AIT&#xa;results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#c05621;fontSize=11;fontStyle=1;" vertex="1" parent="lanePD">
          <mxGeometry x="1000" y="40" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pd3" value="11. Approve /&#xa;Reject based on&#xa;test results" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=11;fontStyle=1;" vertex="1" parent="lanePD">
          <mxGeometry x="1360" y="30" width="140" height="100" as="geometry" />
        </mxCell>

        <!-- IM steps -->
        <mxCell id="im1" value="3. Stock check&#xa;same P/N specs&#xa;(gap: shortage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=11;fontStyle=1;" vertex="1" parent="laneIM">
          <mxGeometry x="380" y="40" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="im2" value="5. ISSUE S/N&#xa;Ship to ME/site&#xa;Update hierarchy&#xa;Replaced badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=11;fontStyle=1;" vertex="1" parent="laneIM">
          <mxGeometry x="680" y="30" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="im3" value="RED notify&#xa;Project/Order/&#xa;Flight/SDLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;fontStyle=1;" vertex="1" parent="laneIM">
          <mxGeometry x="840" y="40" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="im4" value="12a. On Reject&#xa;issue next&#xa;replacement S/N&#xa;to same ME" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;fontStyle=1;" vertex="1" parent="laneIM">
          <mxGeometry x="1540" y="30" width="140" height="100" as="geometry" />
        </mxCell>

        <!-- FSE -->
        <mxCell id="fseA" value="Onsite with ME: remove faulty (if still present), install replacement,&#xa;support integration / customer handover. Officers list from Occurrence Report." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;" vertex="1" parent="laneFSE">
          <mxGeometry x="60" y="30" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fseB" value="Customer reception ack for delivered patch&#xa;(gap fill — recommended)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;" vertex="1" parent="laneFSE">
          <mxGeometry x="1180" y="30" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Status strip -->
        <mxCell id="stTitle" value="Suggested Track A sub-statuses (store on replacement_request; do not break CaseStatus)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=13;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="st1" value="replacement_requested" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st2" value="pd_approved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#c05621;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="210" y="760" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st3" value="im_issue_pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="760" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st4" value="shipped_replaced_badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="760" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st5" value="ait_in_progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="760" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st6" value="ait_approved /&#xa;ait_rejected→loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="760" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st7" value="patch_delivered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#276749;strokeColor=#276749;fontColor=#fff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="760" width="130" height="40" as="geometry" />
        </mxCell>

        <mxCell id="gapsA" value="Gap fills (recommended, keep optional until productized)&#xa;• Stock shortage / no matching S/N → escalate PD/HM; hold Track A; do not fake issue&#xa;• PD reject of request (pre-issue) vs AIT reject (post-install) — separate reasons&#xa;• Failed replacement unit disposition (return to IM quarantine) before next issue&#xa;• Abort Track A if later NFF proven — cancel request, clear red notification, keep audit&#xa;• ME reassignment if unavailable&#xa;• Link Occurrence attachments as evidence on Replacement Request&#xa;• Config history / hierarchy S/N swap — reuse existing replace resolution mechanics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c53030;align=left;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1720" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-inspect" name="05 Faulty Inspection (IE)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="it" value="Track B detail — Faulty item reception, IE inspection, warranty / discard / repair" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="itb" value="Augments existing returned-unit rework + IM inspect outcomes (repairable | reusable | scrapped) + OEM warranty claims." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#4a5568;" vertex="1" parent="1">
          <mxGeometry x="100" y="56" width="1600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="Faulty auto-queued&#xa;when replacement&#xa;shipped (Track A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Customer ships&#xa;faulty item" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="110" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="IM: Reception Date&#xa;+ notify PD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="110" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="PD assigns IE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#c05621;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="IE requests&#xa;handover from IM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="IM issues faulty&#xa;to IE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="110" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="Status:&#xa;Inspection under&#xa;process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="110" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="eb12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb23" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb34" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb45" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb56" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb67" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="dRep" value="Repairable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="260" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="eb7d" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="b7" target="dRep">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1265" y="240" />
              <mxPoint x="675" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Irreparable branch -->
        <mxCell id="dWar" value="Under&#xa;warranty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="260" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="YES — Ship to supplier&#xa;OEM warranty claim&#xa;(existing claim statuses)&#xa;IE/IM update tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="NO / expired — IE comments&#xa;Send back to IM to DISCARD&#xa;IM → trash&#xa;Badge: Discarded (never reuse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="en1" value="NO" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c53030;fontSize=10;fontStyle=1;" edge="1" parent="1" source="dRep" target="dWar"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ew1" value="Warranty" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;fontSize=10;fontStyle=1;" edge="1" parent="1" source="dWar" target="w1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ew2" value="Expired" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c53030;fontSize=10;fontStyle=1;" edge="1" parent="1" source="dWar" target="w2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Repairable branch -->
        <mxCell id="r1" value="Status: Repair under progress&#xa;IE notifies actual issue / root cause&#xa;(maps under_repair)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#c05621;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="260" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="IE completes repair&#xa;+ test evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="380" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="PD verifies tests&#xa;Approve / Reject repair" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="370" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Approve → mark repaired&#xa;+ test reports → IM restock&#xa;for future projects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1320" y="280" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="Reject → remain Repair under&#xa;progress / rework loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1320" y="400" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ey1" value="YES" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;fontSize=10;fontStyle=1;" edge="1" parent="1" source="dRep" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er23" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er34" value="Pass" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;fontSize=10;fontStyle=1;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er35" value="Fail" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c53030;fontSize=10;fontStyle=1;" edge="1" parent="1" source="r3" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="closeB" value="Track B terminal → contributes to case close gate (with Track A AIT approve). Maintenance case closed when both tracks done (or early Soft/NFF)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;strokeColor=#1a365d;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="560" width="1280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="mapB" value="Existing mapping&#xa;• create_returned_unit_rework on replace → keep; add reception_date + awaiting_arrival state&#xa;• Inspect outcomes repairable/reusable/scrapped → IE drives; IM executes discard/trash&#xa;• Scrapped + active warranty → OEM claim (existing); expired → Discarded badge (NEW display; backend discard already exists)&#xa;• CaseStatus under_inspection / under_repair remain the case-level spine; IE statuses are sub-workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;align=left;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="1680" height="120" as="geometry" />
        </mxCell>

        <mxCell id="gapsB" value="Gap fills&#xa;• Faulty never returned — timeout SLA + PD escalation; Track A may still close with caveat flag&#xa;• Reusable (no fault / soft damage) → restock without full repair (existing reusable outcome)&#xa;• Warranty return from OEM (accepted/rejected) → restock or discard&#xa;• Chain-of-custody scan (QR) at IM receive / IE issue — optional&#xa;• IE cannot discard directly — only recommend; IM confirms trash (segregation of duties)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c53030;align=left;spacingLeft=12;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="1680" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-status" name="06 Statuses, Badges &amp; Gaps">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="stt" value="Statuses, notifications, badges &amp; missing functionality summary" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1560" height="36" as="geometry" />
        </mxCell>

        <mxCell id="caseBox" value="CaseStatus (UNCHANGED spine)" style="swimlane;fontStyle=1;startSize=28;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="open → under_inspection → under_repair → resolved → closed&#xa;&#xa;Occurrence Report typically while open.&#xa;Track A/B run under open/under_inspection/under_repair.&#xa;resolved/closed only after close gate (or Soft/NFF)." style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="caseBox">
          <mxGeometry x="10" y="40" width="540" height="140" as="geometry" />
        </mxCell>

        <mxCell id="repBox" value="Replacement request sub-status (NEW)" style="swimlane;fontStyle=1;startSize=28;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rep1" value="replacement_requested → pd_approved | pd_rejected&#xa;→ im_issue_pending → shipped (Replaced badge ON)&#xa;→ ait_in_progress → ait_approved | ait_rejected&#xa;→ (reject loop) → patch_delivered → track_a_closed" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="repBox">
          <mxGeometry x="10" y="40" width="540" height="140" as="geometry" />
        </mxCell>

        <mxCell id="insBox" value="Inspection sub-status (NEW / mapped)" style="swimlane;fontStyle=1;startSize=28;fillColor=#c6f6d5;strokeColor=#276749;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="80" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ins1" value="awaiting_faulty_arrival → received&#xa;→ ie_assigned → issued_to_ie&#xa;→ inspection_under_process&#xa;→ repair_under_progress | warranty_claim | discard_pending&#xa;→ restocked | discarded | claim_closed" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="insBox">
          <mxGeometry x="10" y="40" width="500" height="140" as="geometry" />
        </mxCell>

        <mxCell id="badgeBox" value="Badges &amp; UI signals" style="swimlane;fontStyle=1;startSize=28;fillColor=#fed7d7;strokeColor=#c53030;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="840" height="220" as="geometry" />
        </mxCell>
        <mxCell id="badge1" value="• RED notification chip on Project / Order / Flight / SDLS while replacement case open (priority=high; new event type e.g. replacement_case_open)&#xa;• Replaced — on entity / inventory / hierarchy everywhere new S/N is shown after issue/ship&#xa;• Discarded — inventory table row after IM trash (never selectable for reserve/issue)&#xa;• Existing: Replaced on faulty-entity resolve; hierarchy R{n} sequence — keep&#xa;• Clear RED notification when Track A patch_delivered OR aborted" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="badgeBox">
          <mxGeometry x="10" y="40" width="820" height="160" as="geometry" />
        </mxCell>

        <mxCell id="roleBox" value="Roles to seed / wire" style="swimlane;fontStyle=1;startSize=28;fillColor=#feebc8;strokeColor=#c05621;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="310" width="820" height="220" as="geometry" />
        </mxCell>
        <mxCell id="role1" value="NEW: MaintenanceEngineer (ME), FieldServiceEngineer (FSE), InspectionEngineer (IE)&#xa;EXISTING: ProjectDirector (PD), InventoryManager (IM), Maintenance (legacy notify), Admin&#xa;&#xa;Permissions (additive):&#xa;ME — create/advance replacement request, AIT upload, site actions&#xa;IE — request handover, inspection disposition, repair updates&#xa;FSE — contribute Occurrence Report officers; site assist&#xa;PD — approve replacement, assign ME/IE, AIT &amp; repair gates&#xa;IM — issue/receive/discard/restock (existing + custody)" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="roleBox">
          <mxGeometry x="10" y="40" width="800" height="160" as="geometry" />
        </mxCell>

        <mxCell id="notify" value="Notification matrix (high = red)" style="swimlane;fontStyle=1;startSize=28;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1680" height="200" as="geometry" />
        </mxCell>
        <mxCell id="notify1" value="Event → Audience (priority)&#xa;occurrence_recorded → PD, ME (normal)&#xa;replacement_requested → PD (high)&#xa;replacement_approved / ME assigned → ME, IM (high)&#xa;replacement_shipped / S/N swapped → Project/Order/Flight/SDLS watchers (high RED), ME, FSE&#xa;ait_in_progress → PD (normal)&#xa;ait_approved / ait_rejected → ME, IM (high on reject)&#xa;faulty_received → PD (high)&#xa;ie_assigned / issued_to_ie → IE, IM (normal)&#xa;inspection_disposition → PD (normal)&#xa;discard_completed → PD, IM (normal)&#xa;repaired_restocked → PD, IM (normal)&#xa;case_closed → watchers (normal)" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;" vertex="1" parent="notify">
          <mxGeometry x="10" y="36" width="1660" height="150" as="geometry" />
        </mxCell>

        <mxCell id="miss" value="Missing functionality added for logical completeness (implementation backlog)" style="swimlane;fontStyle=1;startSize=28;fillColor=#fff5f5;strokeColor=#c53030;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1680" height="280" as="geometry" />
        </mxCell>
        <mxCell id="miss1" value="1. Occurrence Date vs Recorded Date; named attachments; FSE officers dialog; Fault Type on report; NFF confirm-close modal&#xa;2. ME / FSE / IE roles + Replacement Request entity linked to maintenance case (parallel to, not replacing, faulty-entity resolve)&#xa;3. Dual-track board on case detail (Track A + Track B progress)&#xa;4. Immediate ship without waiting for faulty; auto awaiting_faulty_arrival rework&#xa;5. RED replacement-open notification on hierarchy entities; Replaced + Discarded badges&#xa;6. AIT Approve/Reject loop with failed-unit return to IM before next issue&#xa;7. Stock shortage escalation; ME reassignment; abort replacement if NFF later&#xa;8. Customer reception ack for patch; faulty-never-returned SLA&#xa;9. Segregation: IE recommends discard; IM executes trash&#xa;10. Preserve soft_fix, tree investigation, warranty claim statuses, delivery close — no regressions&#xa;11. Optional: attachment category tags; QR custody at receive/issue; OEM return restock path&#xa;12. Spelling in UI: prefer “Occurrence Report” (correct English) while matching product language if “Occurance” is mandated" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" vertex="1" parent="miss">
          <mxGeometry x="10" y="36" width="1660" height="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        <mxCell id="e37" style="endArrow=block;endFill=1;strokeColor=#c05621;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e38" value="FCFS auto-reserve" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;dashed=1;strokeColor=#975a16;fontSize=10;" edge="1" parent="1" source="c38" target="c33">

        <mxCell id="note4" value="All status changes are automatic — no manual update needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#6b46c1;fontStyle=2;fontSize=12;" vertex="1" parent="1">

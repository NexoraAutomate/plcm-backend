        <mxCell id="e32y" value="Yes" style="endArrow=block;endFill=1;strokeColor=#276749;fontStyle=1;fontSize=12;" edge="1" parent="1" source="d32" target="c33"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e32n" value="No" style="endArrow=block;endFill=1;strokeColor=#c53030;fontStyle=1;fontSize=12;" edge="1" parent="1" source="d32" target="c35"><mxGeometry relative="1" as="geometry" /></mxCell>

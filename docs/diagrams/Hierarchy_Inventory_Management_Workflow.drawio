        <mxCell id="c38" value="3.8 Auto-remove from shortage list&#xa;&amp; auto-reserve (FCFS)&#xa;→ loop back to reservation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf089;strokeColor=#975a16;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="910" y="490" width="240" height="70" as="geometry" />

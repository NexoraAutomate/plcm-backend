  <diagram id="page-dual" name="03 Dual-Track Split">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;fontColor=#1a365d;" value="After fault confirmation — Dual track (do not wait for faulty item)" vertex="1">
          <mxGeometry height="36" width="1560" x="120" y="20" as="geometry" />
        </mxCell>
        <mxCell id="dtb" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#4a5568;" value="Replacement ships immediately from SUPARCO stock (same specs). Faulty item return is parallel and may start later on client reception." vertex="1">
          <mxGeometry height="24" width="1560" x="120" y="56" as="geometry" />

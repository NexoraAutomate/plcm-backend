<mxfile host="app.diagrams.net" agent="PLCM-Maintenance-Workflow" pages="6">
  <diagram id="page-overview" name="01 Overview &amp; Principles">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1a365d;" value="PLCM Maintenance Augmentation — Occurrence Report + Parallel Replacement / Inspection" vertex="1">
          <mxGeometry height="36" width="1640" x="80" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t1b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#4a5568;" value="Augments existing maintenance case flow. Does not replace soft-fix, tree investigation, IM rework queue, warranty claim, or delivery-close paths already in PLCM." vertex="1">
          <mxGeometry height="24" width="1640" x="80" y="56" as="geometry" />
        </mxCell>
        <mxCell id="princ" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#2c5282;" value="Design principles&#xa;• Augment only — keep CaseStatus (open → under_inspection → under_repair → resolved → closed)&#xa;• Dual-track after fault confirmation: Track A Replacement (do not wait for faulty return) + Track B Faulty return/inspection (starts on reception)&#xa;• New actors ME / FSE / IE sit beside existing PD / IM; existing permissions remain&#xa;• Red “Replacement case open” on Project / Order / Flight / SDLS until AIT pass + case closed&#xa;• Badges: Replaced (new S/N) · Discarded (trash, never reusable)" vertex="1">
          <mxGeometry height="160" width="820" x="60" y="100" as="geometry" />
        </mxCell>
        <mxCell id="roles" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;align=left;spacingLeft=12;spacingTop=8;fontSize=11;" value="Role map (new + existing)&#xa;&#xa;FSE — Field Service Engineer: onsite presence, Occurrence Report, site replace/integrate with ME&#xa;ME — Maintenance Engineer (NEW): owns replacement request → IM issue → site AIT → PD notify&#xa;PD — Project Director: approve replacement, assign ME/IE, Approve/Reject AIT, verify repair tests&#xa;IM — Inventory Manager: issue replacement S/N, receive faulty, issue to IE, discard/trash, restock repaired&#xa;IE — Inspection Engineer (NEW): inspect faulty, warranty vs discard vs repair, update investigation status&#xa;&#xa;Existing roles HM / Admin / Dev unchanged. Legacy role “Maintenance” remains notify target until ME is seeded." vertex="1">
          <mxGeometry height="160" width="820" x="900" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c0" parent="1" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontStyle=1;fontSize=11;" value="1 Case open&#xa;(existing)" vertex="1">
          <mxGeometry height="56" width="150" x="60" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontStyle=1;fontSize=11;" value="2 Occurrence&#xa;Report" vertex="1">
          <mxGeometry height="56" width="150" x="200" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontStyle=1;fontSize=11;" value="3 Fault&#xa;confirm" vertex="1">
          <mxGeometry height="56" width="140" x="340" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontStyle=1;fontSize=11;" value="4A Immediate&#xa;replacement" vertex="1">
          <mxGeometry height="56" width="170" x="470" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontStyle=1;fontSize=11;" value="4B Faulty&#xa;return (parallel)" vertex="1">
          <mxGeometry height="56" width="170" x="630" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontStyle=1;fontSize=11;" value="5 AIT / PD&#xa;gate" vertex="1">
          <mxGeometry height="56" width="140" x="790" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#c05621;fontStyle=1;fontSize=11;" value="6 Inspect /&#xa;Repair / Discard" vertex="1">
          <mxGeometry height="56" width="170" x="920" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="shape=chevron;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontStyle=1;fontSize=11;" value="7 Close&#xa;case" vertex="1">
          <mxGeometry height="56" width="140" x="1080" y="300" as="geometry" />
        </mxCell>
        <mxCell id="mTitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;fontColor=#1a365d;" value="Master flow (logical) — existing steps grey; new / modified blue-purple" vertex="1">
          <mxGeometry height="28" width="700" x="60" y="390" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Case open&lt;/b&gt;&lt;br&gt;(existing)&lt;br&gt;&lt;br&gt;Lookup S/N · project gate&lt;br&gt;production-support check" vertex="1">
          <mxGeometry height="90" width="160" x="60" y="440" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Occurrence Report&lt;/b&gt;&lt;br&gt;(rename onsite)&lt;br&gt;&lt;br&gt;Occurrence date ≠ recorded&lt;br&gt;Attachments (named)&lt;br&gt;FSE officers + roles&lt;br&gt;Outcome + Fault type" vertex="1">
          <mxGeometry height="110" width="170" x="270" y="430" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontStyle=1;fontSize=11;" value="Outcome&#xa;branch?" vertex="1">
          <mxGeometry height="70" width="140" x="480" y="450" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Soft fix / NFF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Soft fix → resolve soft_fixed&lt;br&gt;NFF → confirm close/resolve&lt;br&gt;Inconclusive → keep open" vertex="1">
          <mxGeometry height="110" width="200" x="730" y="430" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Fault identified&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirm via email / letter / call&lt;br&gt;Start Track A immediately&lt;br&gt;Tree investigation continues&lt;br&gt;(existing) in parallel" vertex="1">
          <mxGeometry height="110" width="220" x="980" y="430" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Dual track&lt;/b&gt;&lt;br&gt;&lt;br&gt;A: ME replacement + AIT&lt;br&gt;B: Faulty → IM → IE&lt;br&gt;Close when both complete&lt;br&gt;(AIT pass + inspect closed)" vertex="1">
          <mxGeometry height="110" width="220" x="1250" y="430" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" edge="1" parent="1" source="d3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#276749;fontSize=10;fontStyle=1;" target="s4" value="Soft / NFF /&#xa;Inconclusive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e35" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6b46c1;fontSize=10;fontStyle=1;" value="Fault&#xa;identified">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600.0000000000002" y="560" as="sourcePoint" />
            <mxPoint x="960" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e56" edge="1" parent="1" source="s5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2d3748;" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#dd6b20;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;" value="Legend&#xa;Grey = existing preserved&#xa;Blue = Occurrence Report UI&#xa;Purple = Replacement track (ME)&#xa;Green = Inspection / close&#xa;Yellow = decision&#xa;Red = AIT / dual-track gate" vertex="1">
          <mxGeometry height="150" width="220" x="60" y="580" as="geometry" />
        </mxCell>
        <mxCell id="map" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fafc;strokeColor=#718096;align=left;spacingLeft=12;spacingTop=8;fontSize=11;" value="How this maps onto existing PLCM&#xa;&#xa;• Occurrence Report replaces UI label “Onsite visit outcome” / button “Record onsite outcome” — API can keep onsite_* fields + add occurrence_date, attachments[], officers[]&#xa;• Fault types already exist as FaultType enum (Electrical, Mechanical, Environmental, Hardware, Manufacturing Defect, Physical Damage, Software, Unclassified, Wear, Other) — surface on Occurrence Report&#xa;• Track A uses / extends resolution_type=replaced + stock issue; adds ME request + PD approve + AIT loop before case close&#xa;• Track B uses / extends returned_unit rework + IM inspect queue; adds PD→IE assignment and “Inspection under process” / “Repair under progress” sub-statuses&#xa;• Soft fix path unchanged (resolve_soft_fixed). NFF adds explicit confirm-to-close dialog (new UX on existing resolution_type=no_fault_found)" vertex="1">
          <mxGeometry height="150" width="1160" x="310" y="580" as="geometry" />
        </mxCell>
        <mxCell id="pages" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;strokeColor=#1a365d;fontColor=#ffffff;fontSize=12;fontStyle=1;" value="Pages: 01 Overview · 02 Occurrence Report · 03 Dual-track split · 04 Replacement / AIT (ME) · 05 Faulty inspection (IE) · 06 Statuses, badges, gaps" vertex="1">
          <mxGeometry height="40" width="1470" x="60" y="760" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-occurrence" name="02 Occurrence Report">
    <mxGraphModel dx="1373" dy="544" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ot" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;fontColor=#1a365d;" value="Occurrence Report (formerly Onsite visit outcome)" vertex="1">
          <mxGeometry height="36" width="1400" x="200" y="20" as="geometry" />
        </mxCell>
        <mxCell id="otb" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#4a5568;" value="Recorded after case open. Captures field event facts separately from system audit timestamps." vertex="1">
          <mxGeometry height="24" width="1400" x="200" y="56" as="geometry" />
        </mxCell>
        <mxCell id="form" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=13;" value="Occurrence Report form fields" vertex="1">
          <mxGeometry height="520" width="520" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="form" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="1. Occurrence Date (user) — when the field event happened&#xa;2. Recorded Date/Time (system) — onsite_recorded_at (immutable)&#xa;3. Recorded By (system) — onsite_recorded_by_id&#xa;4. Outcome (required) — see dropdown&#xa;5. Fault Type (required if fault / optional otherwise) — see list&#xa;6. Soft-fix method — only if Soft fix (existing)&#xa;7. Notes / narrative&#xa;8. Attachments[] — each: file + user-defined name&#xa;   (tests, reports, emails, letters, photos)&#xa;9. Field officers[] — dialog: name/user + onsite role&#xa;10. Confirmation channel (if fault) — email / letter / call&#xa;    + reference id / attachment link" vertex="1">
          <mxGeometry height="280" width="500" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b6cb0;strokeColor=#2b6cb0;fontColor=#ffffff;fontStyle=1;fontSize=12;" value="Button: Record Occurrence Report&#xa;(was: Record onsite outcome)" vertex="1">
          <mxGeometry height="44" width="340" x="80" y="340" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;fontSize=11;align=left;spacingLeft=8;" value="Preserve existing API fields; add occurrence_date,&#xa;attachments[{name,file}], officers[{user_id,role_onsite}],&#xa;fault_type on report, confirmation_channel." vertex="1">
          <mxGeometry height="90" width="480" x="20" y="400" as="geometry" />
        </mxCell>
        <mxCell id="outBox" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#fefcbf;strokeColor=#975a16;fontSize=13;" value="Outcome dropdown (existing + NFF)" vertex="1">
          <mxGeometry height="300" width="360" x="590" y="100" as="geometry" />
        </mxCell>
        <mxCell id="o1" parent="outBox" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="• Soft fix (existing soft_fix)&#xa;• PN / hardware fault (existing fault_identified)&#xa;• Inconclusive (existing)&#xa;• No Fault Found (NEW outcome value&#xa;  OR map to resolution NFF with prompt)&#xa;&#xa;After save:&#xa;Soft fix → auto resolve soft_fixed (keep)&#xa;NFF → modal: Close / resolve case as NFF?&#xa;  Yes → resolve + close path&#xa;  No → leave case open with NFF note&#xa;Inconclusive → case stays open&#xa;Fault identified → enable Track A CTA" vertex="1">
          <mxGeometry height="250" width="340" x="10" y="36" as="geometry" />
        </mxCell>
        <mxCell id="ftBox" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=13;" value="Fault Type (from product list / FaultType enum)" vertex="1">
          <mxGeometry height="300" width="360" x="980" y="100" as="geometry" />
        </mxCell>
        <mxCell id="ft1" parent="ftBox" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="1. Electrical&#xa;2. Mechanical&#xa;3. Environmental&#xa;4. Hardware&#xa;5. Manufacturing Defect&#xa;6. Physical Damage&#xa;7. Software&#xa;8. Unclassified (default)&#xa;9. Wear&#xa;10. Other&#xa;&#xa;Shown alongside Outcome when&#xa;fault_identified (and optionally NFF&#xa;classification). Matches attached UI list." vertex="1">
          <mxGeometry height="250" width="340" x="10" y="36" as="geometry" />
        </mxCell>
        <mxCell id="fse" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#c6f6d5;strokeColor=#276749;fontSize=13;" value="Field officers dialog (FSE+)" vertex="1">
          <mxGeometry height="280" width="360" x="590" y="430" as="geometry" />
        </mxCell>
        <mxCell id="fse1" parent="fse" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="Open dialog → Add officer rows:&#xa;• User (directory) or free-text guest&#xa;• Designated onsite role&#xa;  e.g. Lead FSE, FSE, Customer Rep,&#xa;  Observer, ME (if already on site)&#xa;• Optional contact / phone&#xa;&#xa;At least one FSE recommended when&#xa;outcome = fault_identified.&#xa;Stored on case for audit &amp; later&#xa;site-replace coordination with ME." vertex="1">
          <mxGeometry height="230" width="340" x="10" y="36" as="geometry" />
        </mxCell>
        <mxCell id="att" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#feebc8;strokeColor=#c05621;fontSize=13;" value="Named attachments" vertex="1">
          <mxGeometry height="280" width="360" x="980" y="430" as="geometry" />
        </mxCell>
        <mxCell id="att1" parent="att" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="Each upload requires a Display Name&#xa;defined by the user, e.g.:&#xa;• “Customer fault email 03-Nov”&#xa;• “AIT pretest PDF”&#xa;• “Supplier letter”&#xa;&#xa;Types: test reports, emails, letters,&#xa;photos, logs. Reusable later as&#xa;evidence for warranty / IE / PD AIT gate.&#xa;&#xa;Missing (gap fill): attachment category&#xa;tag + virus-scan / size limits (ops)." vertex="1">
          <mxGeometry height="230" width="340" x="10" y="36" as="geometry" />
        </mxCell>
        <mxCell id="af" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;fontColor=#1a365d;" value="After Record Occurrence Report" vertex="1">
          <mxGeometry height="28" width="400" x="100" y="730" as="geometry" />
        </mxCell>
        <mxCell id="vi9D-Qsdmv2FizptG1I2-2" edge="1" parent="1" source="dOut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="aFlt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vi9D-Qsdmv2FizptG1I2-4" connectable="0" parent="vi9D-Qsdmv2FizptG1I2-2" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;defaultLabelBackgroundColor=page;" value="Fault" vertex="1">
          <mxGeometry relative="1" x="-0.19" y="-3" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dOut" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fefcbf;strokeColor=#975a16;fontStyle=1;fontSize=12;" value="Outcome?" vertex="1">
          <mxGeometry height="90" width="140" x="700" y="880" as="geometry" />
        </mxCell>
        <mxCell id="nshryI87dyUFvuZXJYgx-1" edge="1" parent="1" source="dOut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="aNff" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vi9D-Qsdmv2FizptG1I2-3" connectable="0" parent="nshryI87dyUFvuZXJYgx-1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;defaultLabelBackgroundColor=page;" value="NFF" vertex="1">
          <mxGeometry relative="1" x="-0.0931" y="-2" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="aSoft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#276749;fontSize=11;" value="Soft fix&#xa;→ resolve soft_fixed&#xa;(existing)" vertex="1">
          <mxGeometry height="80" width="160" x="690" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="aNff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#c53030;fontSize=11;" value="No Fault Found&#xa;→ Confirm close/resolve?&#xa;Yes: NFF + closed&#xa;No: note only" vertex="1">
          <mxGeometry height="90" width="180" x="970" y="880" as="geometry" />
        </mxCell>
        <mxCell id="aInc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=11;" value="Inconclusive&#xa;→ stay Open&#xa;further visit / data" vertex="1">

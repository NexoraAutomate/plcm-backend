  <diagram id="page-status" name="06 Statuses, Badges &amp; Gaps">
    <mxGraphModel dx="2478" dy="1018" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="stt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;fontColor=#1a365d;" value="Statuses, notifications, badges &amp; missing functionality summary" vertex="1">
          <mxGeometry height="36" width="1560" x="120" y="20" as="geometry" />
        </mxCell>
        <mxCell id="caseBox" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#e2e8f0;strokeColor=#4a5568;fontSize=13;" value="CaseStatus (UNCHANGED spine)" vertex="1">
          <mxGeometry height="200" width="560" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="case1" parent="caseBox" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="open → under_inspection → under_repair → resolved → closed&#xa;&#xa;Occurrence Report typically while open.&#xa;Track A/B run under open/under_inspection/under_repair.&#xa;resolved/closed only after close gate (or Soft/NFF)." vertex="1">
          <mxGeometry height="140" width="540" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="repBox" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#e9d8fd;strokeColor=#6b46c1;fontSize=13;" value="Replacement request sub-status (NEW)" vertex="1">
          <mxGeometry height="200" width="560" x="620" y="80" as="geometry" />
        </mxCell>
        <mxCell id="rep1" parent="repBox" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="replacement_requested → pd_approved | pd_rejected&#xa;→ im_issue_pending → shipped (Replaced badge ON)&#xa;→ ait_in_progress → ait_approved | ait_rejected&#xa;→ (reject loop) → patch_delivered → track_a_closed" vertex="1">
          <mxGeometry height="140" width="540" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="insBox" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#c6f6d5;strokeColor=#276749;fontSize=13;" value="Inspection sub-status (NEW / mapped)" vertex="1">
          <mxGeometry height="200" width="520" x="1200" y="80" as="geometry" />
        </mxCell>
        <mxCell id="ins1" parent="insBox" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="awaiting_faulty_arrival → received&#xa;→ ie_assigned → issued_to_ie&#xa;→ inspection_under_process&#xa;→ repair_under_progress | warranty_claim | discard_pending&#xa;→ restocked | discarded | claim_closed" vertex="1">
          <mxGeometry height="140" width="500" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="badgeBox" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#fed7d7;strokeColor=#c53030;fontSize=13;" value="Badges &amp; UI signals" vertex="1">
          <mxGeometry height="220" width="840" x="40" y="310" as="geometry" />
        </mxCell>
        <mxCell id="badge1" parent="badgeBox" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="• RED notification chip on Project / Order / Flight / SDLS while replacement case open (priority=high; new event type e.g. replacement_case_open)&#xa;• Replaced — on entity / inventory / hierarchy everywhere new S/N is shown after issue/ship&#xa;• Discarded — inventory table row after IM trash (never selectable for reserve/issue)&#xa;• Existing: Replaced on faulty-entity resolve; hierarchy R{n} sequence — keep&#xa;• Clear RED notification when Track A patch_delivered OR aborted" vertex="1">
          <mxGeometry height="160" width="820" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="roleBox" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#feebc8;strokeColor=#c05621;fontSize=13;" value="Roles to seed / wire" vertex="1">
          <mxGeometry height="220" width="820" x="900" y="310" as="geometry" />
        </mxCell>
        <mxCell id="role1" parent="roleBox" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;" value="NEW: MaintenanceEngineer (ME), FieldServiceEngineer (FSE), InspectionEngineer (IE)&#xa;EXISTING: ProjectDirector (PD), InventoryManager (IM), Maintenance (legacy notify), Admin&#xa;&#xa;Permissions (additive):&#xa;ME — create/advance replacement request, AIT upload, site actions&#xa;IE — request handover, inspection disposition, repair updates&#xa;FSE — contribute Occurrence Report officers; site assist&#xa;PD — approve replacement, assign ME/IE, AIT &amp; repair gates&#xa;IM — issue/receive/discard/restock (existing + custody)" vertex="1">
          <mxGeometry height="160" width="800" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="notify" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#bee3f8;strokeColor=#2b6cb0;fontSize=13;" value="Notification matrix (high = red)" vertex="1">
          <mxGeometry height="200" width="1680" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="notify1" parent="notify" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;" value="Event → Audience (priority)&#xa;occurrence_recorded → PD, ME (normal)&#xa;replacement_requested → PD (high)&#xa;replacement_approved / ME assigned → ME, IM (high)&#xa;replacement_shipped / S/N swapped → Project/Order/Flight/SDLS watchers (high RED), ME, FSE&#xa;ait_in_progress → PD (normal)&#xa;ait_approved / ait_rejected → ME, IM (high on reject)&#xa;faulty_received → PD (high)&#xa;ie_assigned / issued_to_ie → IE, IM (normal)&#xa;inspection_disposition → PD (normal)&#xa;discard_completed → PD, IM (normal)&#xa;repaired_restocked → PD, IM (normal)&#xa;case_closed → watchers (normal)" vertex="1">
          <mxGeometry height="150" width="1660" x="10" y="36" as="geometry" />
        </mxCell>
        <mxCell id="miss" parent="1" style="swimlane;fontStyle=1;startSize=28;fillColor=#fff5f5;strokeColor=#c53030;fontSize=13;" value="Missing functionality added for logical completeness (implementation backlog)" vertex="1">
          <mxGeometry height="280" width="1680" x="40" y="790" as="geometry" />
        </mxCell>
